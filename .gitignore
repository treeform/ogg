# Ignore files with no extention.
*
!*/
!*.*
!LICENSE

# Ignore hidden files, but not the license or github files.
.*
!.github/
!.github/**
!.gitignore
!.gitattributes

# Normal ignores.
*.exe
nimcache
*.pdb
*.ilk
*.out

# Project specific ignores.
!tests/reference/vendor/**/COPYING
!tests/reference/vendor/**/AUTHORS
!tests/reference/vendor/**/README
__pycache__/
*.pyc
/tmp/
